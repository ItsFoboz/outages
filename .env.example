# Server port (default: 3001)
PORT=3001

# Google Maps Geocoding API key — needed for geocoding outage locations
# Enable "Geocoding API" in Google Cloud Console
# https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend origin (used for CORS in production)
FRONTEND_URL=http://localhost:5173

# Vite: Google Maps JavaScript API key — needed for the map view in the frontend
# Enable "Maps JavaScript API" in Google Cloud Console
# Both can be the same key — restrict it to your domain + localhost in GCP
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
